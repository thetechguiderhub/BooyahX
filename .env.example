# ============================================
# BOOYAHX — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# Server
PORT=3000
NODE_ENV=LOCAL_DEVELOPMENT
SESSION_SECRET=change-this-to-a-random-secret-string

# Public origin (production: https://booyahx.vercel.app — controls CORS allowlist,
# secure cookies and OAuth redirect derivation)
APP_URL=

# OAuth (Google). Secrets live ONLY here — never in frontend code.
# Register BOTH callback URLs in the Google Cloud console:
#   http://localhost:3000/api/auth/oauth/google/callback   (local development)
#   https://booyahx.vercel.app/api/auth/oauth/google/callback (production)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=

# Database
DATABASE_PATH=./data/booyahx.db

# Owner Accounts (seeded on first run; passwords are read from env and bcrypt-hashed — never stored in plaintext)
PRIMARY_OWNER_EMAIL=itxmeshadow1234@gmail.com
PRIMARY_OWNER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
TEMPORARY_OWNER_EMAIL=murtaza12@gmail.com
TEMPORARY_OWNER_PASSWORD=Murtaza12

# Payment Integration (not configured by default)
EPAYPAISA_API_KEY=
EPAYPAISA_API_SECRET=
JAZZCASH_API_KEY=
JAZZCASH_API_SECRET=

# Email Service (not configured by default)
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
